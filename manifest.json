{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "permissions": ["storage", "offscreen", "cookies"],
  "host_permissions": [
    "https://music.163.com/*",
    "https://*.music.126.net/*",
    "https://*.126.net/*",
    "https://api.qrserver.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/netease-music-mini-16.png",
    "32": "icons/netease-music-mini-32.png",
    "128": "icons/netease-music-mini-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/netease-music-mini-16.png",
      "32": "icons/netease-music-mini-32.png",
      "128": "icons/netease-music-mini-128.png"
    }
  },
  "minimum_chrome_version": "109"
}
